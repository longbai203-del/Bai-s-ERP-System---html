# --- 门店基础信息 ---
STORE_NAME=Carwash Pro 旗舰洗车中心
STORE_CODE=CW-001

# --- 沙特税务与合规 ---
# 沙特 15% VAT 标准税率
VAT_RATE=0.15
# 沙特 ZATCA 15 位税务登记号 (示例)
TAX_NUMBER=312345678901234
DEFAULT_CURRENCY=SAR

# --- 系统偏好 ---
# 默认语言: zh (中文), en (英文), ar (阿拉伯文)
DEFAULT_LANG=zh
DEFAULT_DATE_FORMAT=YYYY-MM-DD
RECEIPT_PRINTER_WIDTH=80

# --- 预警阈值 ---
LOW_STOCK_ALERT_DAYS=7
DOC_EXPIRE_ALERT_DAYS=30