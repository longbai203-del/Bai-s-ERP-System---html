{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/modules/(.*)", "destination": "/modules/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(json|ico|png|jpg|jpeg|svg|webp|ttf|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}