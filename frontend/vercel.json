{
    "version": 2,
    "name": "bais-erp",
    "builds": [
        { "src": "*.html", "use": "@vercel/static" },
        { "src": "*.js", "use": "@vercel/static" },
        { "src": "css/**", "use": "@vercel/static" },
        { "src": "js/**", "use": "@vercel/static" },
        { "src": "services/**", "use": "@vercel/static" },
        { "src": "modules/**", "use": "@vercel/static" },
        { "src": "layouts/**", "use": "@vercel/static" },
        { "src": "locales/**", "use": "@vercel/static" },
        { "src": "assets/**", "use": "@vercel/static" },
        { "src": "supabase/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/", "dest": "/index.html" },
        { "src": "/login", "dest": "/login.html" },
        { "src": "/register", "dest": "/register.html" },
        { "src": "/modules/(.*)", "dest": "/modules/$1" },
        { "src": "/(.*)", "dest": "/404.html" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/(.*.html)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        }
    ],
    "env": {
        "VITE_SUPABASE_URL": "https://qryllswlfryaywiajilr.supabase.co",
        "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFyeWxsc3dsZnJ5YXl3aWFqaWxyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MzUxMjgsImV4cCI6MjEwMjMxMTEyOH0.g0i02OViDEINfXLMksp1oWNKoactxOBlylyTdDXr5qs"
    }
}
