{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/404", "dest": "/404.html" },
    { 
      "src": "/(.*)\\.html", 
      "dest": "/$1.html" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/$1" 
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(json|ico|png|jpg|jpeg|svg|webp|ttf|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}